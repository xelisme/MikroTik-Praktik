    "narrative": {
      "northStar": "The Friendly Belajar Bench (Ruangguru-inspired)",
      "overview": "A welcoming, high-energy learning surface where students practice real MikroTik configs with a calm safety net. Borrows the friendly, student-first language of Indonesia's favorite belajar platform: vibrant orange as the action color, a confident blue as the learning companion, white/very-light surfaces, Inter throughout, and pill-shaped rounded components that feel approachable. The read-only promise stays visible (a clear READ-ONLY banner on every assessment), but the mood is encouraging and energetic — learning should feel inviting, not clinical. The system is student-first: big friendly CTAs, rounded card-based content, and the AI assistant signalled with the orange accent so help is always one tap away.",
      "keyCharacteristics": [
        "Vibrant orange (#f26d0f) primary on white/light-blue surfaces; blue (#007bff) as the learning companion.",
        "Friendly & high-energy: Inter, pill buttons (100px), rounded 12px cards, soft shadows.",
        "Student-first copy in Bahasa Indonesia; big welcoming CTAs.",
        "Severity is the only place color gets loud — on the left border of an issue card."
      ],
      "rules": [
        { "name": "The Orange Action Rule", "body": "Orange (#f26d0f) is the only chromatic action color — every primary CTA, active tab, and the AI assistant. Blue is the learning companion (links, secondary), not the primary action.", "section": "colors" },
        { "name": "The Severity-Only Loud Rule", "body": "Full-saturation red/amber/green appear only on issue cards and badges. Everywhere else stays in the orange/blue/neutral friendly field.", "section": "colors" },
        { "name": "The One-Font Rule", "body": "Inter carries the entire UI — display, body, and labels. Differentiate by weight/size, not a second face.", "section": "typography" },
        { "name": "The Soft-Float Rule", "body": "Surfaces are flat at rest; a gentle shadow appears as a response to state (hover, elevation, focus). The page field itself carries no shadow.", "section": "elevation" }
      ],
      "dos": [
        "Do keep orange as the only action/accent color; use blue for links/secondary.",
        "Do reserve red/amber/green for issue cards and severity badges.",
        "Do use Inter for the entire UI; differentiate by weight/size.",
        "Do keep surfaces soft at rest; let shadows answer to hover/focus.",
        "Do write all UI copy in Bahasa Indonesia and use big friendly CTAs."
      ],
      "donts": [
        "Don't introduce a second chromatic accent (no purple, teal, pink) outside the severity ramp.",
        "Don't use sharp corners on buttons/inputs — they are pills; cards stay at 12px.",
        "Don't make the UI feel clinical or technical — keep it welcoming and high-energy.",
        "Don't let the chat bubble or terminal break the orange/blue/neutral discipline."
      ]
    }
