# Template environment variables untuk MikroTik Praktik — Guru & Juri AI
# Salin ke .env dan isi nilainya. SEMUA variabel LLM_* bersifat OPSIONAL:
# jika tidak diisi, pengguna dapat mengonfigurasi AI lewat menu Settings di aplikasi
# (disimpan di cookie per-session yang kedaluwarsa setelah 30 menit).

# Base URL API yang kompatibel dengan OpenAI, mis.:
# LLM_BASE_URL=https://api.openai.com/v1

# API Key penyedia AI
# LLM_API_KEY=sk-your-key-here

# Model yang digunakan (default: gpt-4o-mini jika dikosongkan)
# LLM_MODEL=gpt-4o-mini

# Wajib disetel pada deploy hosted (Render/Vercel) agar cookie session tidak mudah dipalsukan.
# Gunakan string acak yang panjang, mis. hasil: openssl rand -hex 32
# COOKIE_SECRET=change-me-to-a-long-random-string
